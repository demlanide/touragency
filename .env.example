# Copy this file to .env and fill in your values (.env is gitignored)

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name to use
MONGODB_DB=centralasia

# Port for the API server
PORT=3001

# Optional: token required to read leads via GET /api/leads
# Send it as the "x-admin-token" header. Leave empty to disable the guard.
ADMIN_TOKEN=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX). Leave empty to disable.
VITE_GA_ID=
